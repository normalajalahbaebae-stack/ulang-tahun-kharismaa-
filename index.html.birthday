<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#4b2038">
<title>Untuk Kharismaa Indah Fadhilah ♡</title>

<style>
:root {
  --pink: #f4b6ce;
  --rose: #c65380;
  --wine: #4b2038;
  --cream: #fff7fa;
  --text: #634052;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--cream);
  color: var(--text);
  font-family: Georgia, "Times New Roman", serif;
  overflow-x: hidden;
}
nav {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #4b2038f2;
  color: white;
  padding: 15px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
nav strong { font-size: 1.1rem; }
nav a {
  color: white;
  text-decoration: none;
  margin: 5px;
  font-size: .9rem;
}
.hero {
  min-height: 90vh;
  display: grid;
  place-items: center;
  text-align: center;
  padding: 40px 20px;
  color: white;
  background:
    linear-gradient(#46203c99,#46203c99),
    radial-gradient(circle at top right,#ffb7d1,transparent 50%),
    linear-gradient(135deg,#633c67,#d67e9e,#f3c5d3);
  position: relative;
}
.hero-content { max-width: 800px; animation: muncul 1.5s ease; }
.kecil { letter-spacing: 4px; text-transform: uppercase; font-size: .8rem; }
h1 { font-size: clamp(2.7rem,9vw,5.8rem); margin: 20px 0; line-height: 1.1; }
h1 span { display: block; font-size: .55em; color: #ffe0ec; margin-top: 15px; font-style: italic; }
.hero p { line-height: 1.9; font-size: 1.1rem; }
.tanggal {
  display: inline-block;
  padding: 12px 22px;
  border: 1px solid white;
  border-radius: 30px;
  margin: 15px 0;
}
.tombol {
  display: inline-block;
  border: none;
  background: var(--rose);
  color: white;
  text-decoration: none;
  border-radius: 30px;
  padding: 13px 23px;
  margin: 8px 4px;
  cursor: pointer;
  font-size: 1rem;
  transition: .3s;
}
.tombol:hover { transform: translateY(-3px); }
.putih { background: white; color: var(--wine); }
section { padding: 70px 7%; }
.judul {
  text-align: center;
  color: var(--wine);
  font-size: clamp(2rem,5vw,3rem);
  margin-bottom: 15px;
}
.subjudul {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 35px;
  line-height: 1.8;
}
.surat-area { background: linear-gradient(135deg,#fff0f5,#f4e7f5); }
.surat {
  max-width: 850px;
  margin: auto;
  padding: clamp(22px,5vw,50px);
  border-radius: 8px 30px;
  background: #fffafd;
  border: 1px solid #efc7d9;
  box-shadow: 0 15px 40px #54243e15;
  line-height: 2;
}
.surat h3 { color: var(--rose); }
.tanda { text-align: right; font-style: italic; color: var(--rose); }
.galeri {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  gap: 18px;
  max-width: 1100px;
  margin: auto;
}
.foto {
  background: white;
  padding: 9px 9px 16px;
  border-radius: 12
